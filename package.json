{
  "name": "car-shop-backend",
  "version": "1.0.0",
  "description": "Car Shop REST API (Express + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx src/db/setup.ts",
    "db:reset": "tsx src/db/setup.ts --reset"
